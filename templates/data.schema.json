{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "小说页面元数据 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "language",
    "writing_started_at",
    "writing_completed_at",
    "timezone",
    "tags",
    "body_character_count",
    "pdf_file",
    "page_count",
    "page_pattern",
    "render_dpi",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "zh-CN"
    },
    "writing_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "writing_completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre",
        "themes",
        "setting",
        "tone",
        "narrative"
      ],
      "properties": {
        "genre": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "setting": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "narrative": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "body_character_count": {
      "type": "integer",
      "minimum": 1
    },
    "pdf_file": {
      "type": "string",
      "pattern": "^\\.\\./[^/\\\\]+\\.pdf$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "page_pattern": {
      "const": "P%04d.png"
    },
    "render_dpi": {
      "const": 200
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body_page",
          "physical_page"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body_page": {
            "type": "integer",
            "minimum": 1
          },
          "physical_page": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
